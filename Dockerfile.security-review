# Candidate only: build and scan before adopting.
FROM python:3.12-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/appuser \
    HF_HOME=/home/appuser/.cache/huggingface

WORKDIR /app
# XGBoost uses the OpenMP runtime on Linux.
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --user-group --uid 10001 appuser

# Cache dependency installation separately from application source changes.
COPY requirements/serve.txt /tmp/requirements-serve.txt
RUN python -m pip install -r /tmp/requirements-serve.txt

COPY pyproject.toml README.md LICENSE ./
COPY src/ ./src/
RUN python -m pip install --no-deps .

USER appuser
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=180s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"]
CMD ["python", "-m", "uvicorn", "maintain_predict.serve:app", "--host", "0.0.0.0", "--port", "8000"]
